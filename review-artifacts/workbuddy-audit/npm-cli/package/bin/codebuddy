#!/usr/bin/env node

// Only opt-in profiling loads the collector; ordinary startup performs no I/O.
if (process.argv[2]?.startsWith('--startup-prof') || process.env.CODEBUDDY_STARTUP_PROFILE === '1') {
    const origin = performance.now();
    const epoch = Date.now();
    const runtimeUptimeAtEntryMs = process.uptime() * 1000;
    try {
        require('./startup-profile.cjs').bootstrap({ origin, epoch, runtimeUptimeAtEntryMs });
    } catch (error) {
        process.stderr.write(`[startup-profile] ${error.message}\n`);
        process.exit(1);
    }
}

// Suppress Node.js DEP0040 (punycode) deprecation warning triggered by dependencies
const originalEmit = process.emit;
process.emit = function (name, data, ...args) {
    if (name === 'warning' && data && data.name === 'DeprecationWarning' && data.code === 'DEP0040') {
        return false;
    }
    return originalEmit.call(process, name, data, ...args);
};

// 记录真正的进程启动时间（在任何模块加载之前）
global.__CODEBUDDY_PROCESS_START_TIME__ = Date.now();

// Exit early if on an older version of Node.js (< 18.20.8)
const minNode = '18.20.8';

/**
 * 启动早期文案（如 Node 版本过旧报错）用的产品名。
 * 定制包（含 customization.json）优先用 branding.cliName，其次 productName；
 * 官方包 / 未配置时回退官方名。懒加载：只在版本检查失败（即将退出）时读文件，
 * 不进入正常启动路径的开销。
 */
function resolveProductCliName() {
    try {
        const custom = require('../customization.json');
        const branding = custom && typeof custom === 'object' && custom.branding;
        const name = branding && (branding.cliName || branding.productName);
        if (typeof name === 'string' && name) {
            return name;
        }
    } catch (_e) {
        // 官方包无 customization.json（files 白名单已排除），或文件缺失/非法 → 回退官方名
    }
    return 'CodeBuddy Code';
}

function compareVersions(current, required) {
    // Extract numeric version parts, ignoring pre-release identifiers (e.g., '14.19.0-rc.0' -> '14.19.0')
    const currentVersion = current.split('-')[0];
    const currentParts = currentVersion.split('.').map(Number);
    const requiredParts = required.split('.').map(Number);

    // If version format is invalid (e.g., less than 3 parts or contains NaN), skip check
    if (currentParts.length < 3 || currentParts.some(isNaN)) {
        return 0; // Treat as passing the check
    }

    for (let i = 0; i < 3; i++) {
        const curr = currentParts[i] || 0;
        const req = requiredParts[i] || 0;
        if (curr < req) return -1;
        if (curr > req) return 1;
    }
    return 0;
}

if (compareVersions(process.versions.node, minNode) < 0) {
    // eslint-disable-next-line no-console
    console.error(
        '\n' +
        `${resolveProductCliName()} requires Node.js v${minNode} or newer.\n` +
        `You are running Node.js v${process.versions.node}.\n` +
        'Please upgrade Node.js: https://nodejs.org/en/download/\n',
    );
    process.exit(1);
}

require('events').EventEmitter.defaultMaxListeners = 50;

// Enable V8 compile cache so the large bundle's parse/compile cost (~130ms for the
// ~16MB TUI bundle) is paid only on the first run. Subsequent starts reuse the cached
// bytecode, cutting bundle load time by ~37% (measured ~400ms -> ~254ms).
//
// `module.enableCompileCache` is available on Node.js >= 22.8.0. On older runtimes the
// API is absent, so we guard it and silently skip (no extra dependency, no behavior change).
//
// Set CODEBUDDY_DISABLE_COMPILE_CACHE=1 to opt out (e.g. for troubleshooting a suspected
// stale-cache issue, or on read-only filesystems where writing the cache is undesirable).
if (process.env.CODEBUDDY_DISABLE_COMPILE_CACHE !== '1') {
    try {
        const { enableCompileCache, getCompileCacheDir, constants } = require('module');

        if (typeof enableCompileCache === 'function') {
            // No directory argument => Node picks a per-user temp location keyed by the
            // module's mtime + Node version, so a stale cache after an upgrade is invalidated.
            const cacheRet = enableCompileCache();

            if (process.env.CODEBUDDY_COMPILE_CACHE_DEBUG === '1') {
                console.log('compileCacheInfo', cacheRet);
            }
        }
    } catch (_e) {
        // Compile cache is a pure optimization; never let it block startup.
    }
}

// windows数据
// 之前
// 8.12s + 8.41s + 8.06s + 8.45s + 8.15s
// v8cache 热启动
// 6.97s + 7.32s + 7.14s + 7.15s + 7.34s
// v8cache 冷启动
// 10.2s + 9.48s + 8.96s

// Fast path for --version / -v: print version and exit before loading any bundle.
// This avoids the full DI container initialization (~150 components), network requests,
// and stdin reads that can cause multi-second startup delays on first install.
{
    const args = process.argv.slice(2);
    const hasVersionFlag = args.includes('--version') || args.includes('-v');
    // Only apply fast path when no positional sub-command is present
    // (e.g. "cbc mcp add -v somevalue" should NOT be treated as a version request)
    const hasSubCommand = args.some(a => !a.startsWith('-'));
    if (hasVersionFlag && !hasSubCommand) {
        try {
            const pkg = require('../package.json');
            const version = (pkg && pkg.publishConfig && pkg.publishConfig.customPackage && pkg.publishConfig.customPackage.version)
                || (pkg && pkg.version)
                || 'unknown';
            // eslint-disable-next-line no-console
            console.log(version);
        } catch (_e) {
            // eslint-disable-next-line no-console
            console.log('unknown');
        }
        process.exit(0);
    }
}

// 宿主（CodeBuddy Desktop）只需 daemon 是否在跑与 endpoint 时的快路径：不加载 bundle。
// 仅在调用方为这一次调用显式设置 CODEBUDDY_DAEMON_STATUS_BRIEF=1 时生效；无法等价判定时回退完整路径。
if (process.env.CODEBUDDY_DAEMON_STATUS_BRIEF === '1'
    && process.argv.length === 4 && process.argv[2] === 'daemon' && process.argv[3] === 'status') {
    const brief = require('./daemon-status-brief.cjs').readBriefDaemonStatus(__dirname);
    if (brief) {
        // eslint-disable-next-line no-console
        console.log(JSON.stringify(brief, null, 2));
        process.exit(0);
    }
}

// 注入产品版本号到 env，供下游 @genie/product ProductManager.getCacheKey() 做版本隔离。
// 放在 fast-path 之后：fast-path 直接 process.exit(0) 不进 bundle，无需此 env，
// 把开销留给真正进 bundle 的路径（相对 ~254ms 的 bundle 加载，require pkg.json 的 ~0.6ms 可忽略；
// 而且 fast-path 命中时其实已经 require 过 pkg.json，这里走 require.cache 命中也不会重新解析）。
// 必须早于下方 require('../dist/codebuddy*') —— 否则 ProductManager 在 @PostConstruct 同步
// loadFromCache 时会读不到 CLIENT_INFO_PRODUCT_VERSION，退到无版本号的兼容 key
// （CodeBuddy-Product-Cache），跨版本升级时旧 schema 字段就会通过 _stableConfiguration 污染
// 新版本的合并 base。
// 不覆盖外部已设置的值（例如父进程通过 spawn env 注入），优先级父进程 > 本兜底。
if (!process.env.CLIENT_INFO_PRODUCT_VERSION) {
    try {
        const pkg = require('../package.json');
        // 与上方 fast-path（--version 分支）的取值逻辑保持一致：
        // 发布产物的版本号在 publishConfig.customPackage.version 里，开发态 fallback 到 pkg.version。
        const version = (pkg && pkg.publishConfig && pkg.publishConfig.customPackage && pkg.publishConfig.customPackage.version)
            || (pkg && pkg.version);
        if (version) {
            process.env.CLIENT_INFO_PRODUCT_VERSION = version;
        }
    } catch (_e) {
        // 拿不到版本号是非致命的；继续启动，cache 退回兼容 key（与未启用版本隔离前行为一致）。
    }
}

// Route to headless bundle when TUI is not needed
const args = process.argv.slice(2);
// 宿主进程显式声明"我不需要 TUI"的 env 通道。argv 判定难以穷举无 TUI 场景
// （例如 WorkBuddy 通过 workbuddy-server 用 `--serve` 起 sidecar、用 `--prewarm`
// 起预热池，都不是交互 TUI），argv 里再补 flag 会跟真实执行策略耦合。改由宿主
// 在 spawn cbc 前设置 `CODEBUDDY_FORCE_HEADLESS_BUNDLE=1`，路由直接命中 headless
// bundle，语义清晰且与 CLI flag 解耦。取值 `1` / `true` 视为真，其它值忽略。
const forceHeadlessEnv = String(process.env.CODEBUDDY_FORCE_HEADLESS_BUNDLE ?? '').toLowerCase();
const forceHeadless = forceHeadlessEnv === '1' || forceHeadlessEnv === 'true';
// WorkBuddy 专属精简 bundle 分流通道（与 headless 同款 env 语义）。宿主
// （workbuddy-server 起 sidecar / prewarm）在 spawn cbc 前设
// `CODEBUDDY_FORCE_LITE_WB_BUNDLE=1`，直接命中 codebuddy-lite-wb.js——它在
// headless 基础上进一步剔除 wb 结构性不用的桶（TUI 视图 / lsp / update /
// record-replay / channel 等），冷启动内存与 parse/compile 更低。
// 优先级高于 headless；产物缺失时按 lite-wb → headless → full 逐级回退。
const forceLiteWbEnv = String(process.env.CODEBUDDY_FORCE_LITE_WB_BUNDLE ?? '').toLowerCase();
const forceLiteWb = forceLiteWbEnv === '1' || forceLiteWbEnv === 'true';
const isHeadless = forceHeadless
    || forceLiteWb
    || args.includes('--print') || args.includes('-p')
    || args.includes('--acp')
    || args.includes('--a2a')
    || args.some(a => a === '--input-format' || a.startsWith('--input-format='))
    || args.some(a => a === '--output-format' || a.startsWith('--output-format='))
    || args.includes('--version') || args.includes('-v')
    || args.includes('--help') || args.includes('-h') || args.includes('help')
    // Daemon and background session commands
    || args[0] === 'daemon'
    || ['ps', 'logs', 'attach', 'kill'].includes(args[0])
    || args.includes('--bg') || args.includes('--background');

// 会话历史 30 天清理只对交互式 CLI（TUI / `--serve` Web UI / `codebuddy cleanup`）缺省开启；
// headless / lite-wb / `--prewarm` 待命进程由宿主或脚本驱动，内核缺省关闭（issue #145446）。
// 按路由意图而非实际加载的产物判定，headless 产物缺失回退 TUI bundle 时也不会开启。
// `||=` 保留显式非空值。
if (!isHeadless && !args.includes('--prewarm')) {
    process.env.CODEBUDDY_SESSION_HISTORY_CLEANUP ||= '1';
}

// Join the host Job before evaluating any application bundle.
if (process.platform === 'win32') {
    require('./no-orphans.cjs').install();
}

// issue #11961：npm/yarn/pnpm/bun 装法下 `install -g` 会原地覆盖同一 install root
// 的 dist/*，砸到运行中的 cbc 进程——包括**自己**（升级完还没退出前触发的
// lazy chunk 加载会 ENOENT / hash 不匹配）。
//
// 挂 global 隐藏方法：源码里 `updateViaPackageManager` spawn `npm install -g` 前会
// **await** 调用它，把当前 bundle 变体对应的 lazy chunk 目录**当前版本**装载进
// Node.js 模块 cache——一旦同一路径 / URL 走过一次 loader 全流程，后续同 key 加载
// 完全跳过 stat + 直接返回 cached module（Node 24 亲测 CJS `require()` 与 ESM
// `import()` 都是此语义）；磁盘覆盖 / 删除对本进程后续加载无影响。
//
// **只加载"本 bundle 版本"对应的 chunks**：
// 构建时 `scripts/lazy-manifest.mjs` 会在每个变体的 lazy 目录下写一份
// `manifest.json`（结构：`{ "lazy_files": ["<id>.<hash>.js", ...] }`）——由于 rspack
// 产物 lazy chunk 已带 `[contenthash]`，不同版本文件名天然唯一。
// 只加载 manifest 里列出的文件的核心动机：**并发多 cbc 场景**——同 install root 下另
// 一个 cbc 已经跑 `install -g` 完成并把 lazy/ 目录换成新版本 chunks 时，本进程若
// 走 readdir 全加载，会把外来版本的 chunks（当前 bundle 引用不到）加进 require.cache
// 造成模块图污染。基于 manifest 加载则只关心自己版本的那批文件，即使已被磁盘替换掉
// （文件不复存在）也只是 require 报错静默跳过，不会拉错版本。
//
// **manifest 读取失败兜底**：老版本产物没写过 manifest、JSON 解析失败或读取异常
// 时，回退到 readdir 全加载（原始行为）——保底能覆盖住老 bundle。
//
// **只加载当前变体**：TUI → `lazy/`，headless → `lazy-headless/`，lite-wb → `lazy-lite-wb/`
// —— 与下方 bundle 分派逻辑对齐，跨变体的 chunk 不属于本进程用到的代码。
//
// 挂钩子必须放在 `isHeadless`/`forceLiteWb` 定义之后、bundle 分派 IIFE 之前：
//   - 前者是为了函数体求值时能拿到值（避免 TDZ）
//   - 后者是为了 bundle 加载后源码里能立即通过 globalThis 访问到
//
// 加载失败静默——升级流程不因预热失败而中断。实际的 IO / require 语义细节见
// `bin/preload-lazy-chunks.cjs`，此处只做变体路径分派。
global.__CODEBUDDY_PRELOAD_LAZY_CHUNKS__ = async function preloadLazyChunks() {
    const pathInner = require('path');
    const { preloadLazyChunks: run } = require('./preload-lazy-chunks.cjs');
    const variant = forceLiteWb ? 'lazy-lite-wb' : isHeadless ? 'lazy-headless' : 'lazy';
    const chunkDir = pathInner.resolve(__dirname, '..', 'dist', variant);
    const result = await run(chunkDir);
    return { ...result, variant };
};

// lite-wb bundle 是 ESM 出图（`.mjs`，heap 优化 2026-09-02），必须走 `await import()`；
// 其它 bundle 仍是 CJS `.js`，保留 `require()`。整个分派包成 async IIFE 以支持
// 混合加载；bin 只做入口分派，不承担后续同步 boot（bundle 内部各自处理）。
;(async () => {
    const startupProfile = globalThis.__CODEBUDDY_STARTUP_PROFILER__;
    if (startupProfile) {
        startupProfile.bundle = forceLiteWb ? 'lite-wb' : isHeadless ? 'headless' : 'tui';
        startupProfile.markEnd('bootstrap');
        startupProfile.markStart('module_load', 'Bundle evaluation + component registration');
    }
    const pathMod = require('path');
    const url = require('url');
    const distDir = pathMod.resolve(__dirname, '..', 'dist');
    const importMjs = async name => import(url.pathToFileURL(pathMod.join(distDir, name)).href);
    try {
        if (forceLiteWb) {
            await importMjs('codebuddy-lite-wb.mjs');
        } else if (isHeadless) {
            require('../dist/codebuddy-headless');
        } else {
            require('../dist/codebuddy');
        }
    } catch (e) {
        // 产物缺失逐级回退：lite-wb → headless → full。ERR_MODULE_NOT_FOUND 是
        // ESM import() 的对应 code；MODULE_NOT_FOUND 是 CJS require 的。
        const missing = e && (e.code === 'MODULE_NOT_FOUND' || e.code === 'ERR_MODULE_NOT_FOUND');
        if (missing) {
            if (forceLiteWb) {
                try {
                    if (startupProfile) { startupProfile.bundle = 'headless'; }
                    require('../dist/codebuddy-headless');
                } catch (e2) {
                    if (e2.code === 'MODULE_NOT_FOUND') {
                        if (startupProfile) { startupProfile.bundle = 'tui'; }
                        require('../dist/codebuddy');
                    } else {
                        throw e2;
                    }
                }
            } else if (isHeadless) {
                if (startupProfile) { startupProfile.bundle = 'tui'; }
                require('../dist/codebuddy');
            } else {
                throw e;
            }
        } else {
            throw e;
        }
    }
})().catch(e => {
    console.error(e);
    process.exit(1);
});
