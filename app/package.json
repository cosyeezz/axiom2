{
  "name": "axiom2",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check:ui": "tsx tests/ui.check.ts",
    "check:sdk": "tsx tests/sdk.check.ts",
    "build:desktop": "vite build --config desktop/vite.config.ts",
    "package:desktop": "npm run build:desktop && node ../scripts/build-desktop.mjs",
    "check:desktop": "tsx tests/desktop.check.ts",
    "check:desktop-update": "tsx tests/desktop-updates.check.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "highlight.js": "10.7.3",
    "marked": "18.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.1.38",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
