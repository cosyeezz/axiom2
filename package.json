{
  "name": "@cosyeezz/axiom2",
  "version": "0.4.17",
  "description": "Local multi-workspace coding agent workbench powered by pi",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/cosyeezz/axiom2.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "axiom2": "bin/axiom2.mjs"
  },
  "files": [
    "npm-shrinkwrap.json",
    "bin/",
    "app/dist/client/",
    "app/dist/server/",
    "app/dist/shared/",
    "app/skills/",
    "app/package.json"
  ],
  "scripts": {
    "build": "node scripts/build-bootstrap.mjs && node scripts/build-native.mjs && npm --prefix app run build",
    "prepare": "npm run build",
    "test": "npm --prefix app test",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "highlight.js": "10.7.3",
    "jsqr": "1.4.0",
    "koffi": "3.3.3",
    "marked": "18.0.11",
    "mermaid": "12.2.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql-formatter": "15.9.0",
    "tar-stream": "3.2.2",
    "typebox": "1.1.38",
    "typescript": "6.0.2",
    "undici": "8.10.2",
    "ws": "8.22.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tar-stream": "3.1.5",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "vite": "8.3.4"
  }
}
